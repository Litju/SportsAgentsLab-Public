# Server-only runtime configuration. Never expose these values through NEXT_PUBLIC_* variables.
DATABASE_URL=
# Optional separated roles. Migration role may own schema; runtime role must not have BYPASSRLS.
DATABASE_MIGRATION_URL=
DATABASE_RUNTIME_URL=
DATABASE_AUTH_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=
BLOB_READ_WRITE_TOKEN=
OPENCODE_API_KEY=
OPENCODE_MODEL_ID=gpt-5.6-luna
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_PROVIDER_PROTOCOL=openai-responses
MEF_SYNTHETIC_ONLY=true
MEF_EVAL_MODE=false
# Local development only; never set these on Preview/Production.
MEF_LOCAL_DEV_IDENTITY=false
MEF_LOCAL_PRINCIPAL_ID=local-dev-user
MEF_LOCAL_ORGANIZATION_ID=org_local_dev
MEF_LOCAL_WORKSPACE_ID=ws_local_dev
# Preview-only operator gate for synthetic bootstrap; keep server-side.
MEF_PREVIEW_BOOTSTRAP_SECRET=
