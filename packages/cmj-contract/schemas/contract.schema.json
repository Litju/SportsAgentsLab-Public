{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sportsagentslab.local/mef/ml109-cmj-processor-contract-1.0.0.schema.json",
  "title": "ML-109 CMJ processor contract",
  "description": "Machine-readable scientific contract authority. This schema describes the closed contract; it does not implement the processor.",
  "type": "object",
  "required": [
    "contract_id",
    "contract_version",
    "protocol",
    "eligible_input",
    "sample_rate_policy",
    "quiet_standing",
    "body_system_weight",
    "gravity",
    "events",
    "phases_included",
    "equations",
    "integration",
    "impulse",
    "metric_pack",
    "excluded_metrics",
    "quality_taxonomy",
    "failure_codes",
    "precision_policy",
    "determinism",
    "calculation_trace",
    "result_hash"
  ],
  "properties": {
    "contract_id": {"type": "string", "const": "ML109-CMJ-PROCESSOR-CONTRACT"},
    "contract_version": {"type": "string", "const": "1.0.0"},
    "protocol": {"type": "object", "required": ["protocol_id", "protocol_version", "starting_position", "arm_hand_condition", "loading_condition", "countermovement_requirement", "allowed_acquisition_configurations", "exclusion_criteria"]},
    "eligible_input": {"type": "object", "required": ["accepted_chain", "required_acquisition_state", "required_configuration_state", "single_total_fz_rule", "dual_independent_fz_rule"]},
    "sample_rate_policy": {"type": "object", "required": ["minimum_supported_rate_hz", "unknown_rate_behavior", "irregular_timebase_behavior", "missing_sample_behavior", "resampling", "filtering", "interpolation"]},
    "quiet_standing": {"type": "object", "required": ["duration_s", "window_definition", "candidate_search", "stability_criterion", "missing_data_tolerance", "failure_code"]},
    "body_system_weight": {"type": "object", "required": ["public_protocol_term", "calculation_baseline_term", "unit", "formula", "mass_formula", "failure_behavior"]},
    "gravity": {"type": "object", "required": ["constant_m_per_s2", "unit", "configurable", "usage"]},
    "events": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["event_id", "input_signal", "baseline", "threshold", "direction", "persistence", "search_interval", "sample_index_convention", "time_convention", "interpolation", "failure_code", "ordering_invariant"]}},
    "phases_included": {"type": "array", "items": {"type": "string", "enum": ["UNWEIGHTING", "BRAKING", "PROPULSION"]}},
    "equations": {"type": "object", "required": ["vertical_force", "net_force", "acceleration", "mass", "sign_convention", "units", "preconditions"]},
    "integration": {"type": "object", "required": ["method", "formula", "timebase", "initial_velocity", "initial_displacement", "endpoint_inclusion", "numerical_precision", "drift_policy", "filter_policy", "resampling_policy", "interpolation_policy"]},
    "impulse": {"type": "object", "required": ["included_variants", "gross_impulse", "phase_impulse", "net_impulse_onset_to_takeoff", "unit"]},
    "metric_pack": {"type": "object", "required": ["metric_pack_id", "metric_pack_version", "status", "primary_metric_count", "metrics"], "properties": {"metrics": {"type": "array", "items": {"type": "object", "required": ["metric_id", "name", "classification", "definition", "formula_source", "unit", "dependencies", "required_events", "required_phases", "quality_prerequisites", "availability_conditions", "internal_precision", "display_rounding"]}}}},
    "excluded_metrics": {"type": "array", "items": {"type": "object", "required": ["metric_id", "name", "reason"]}},
    "quality_taxonomy": {"type": "object", "required": ["states"], "properties": {"states": {"type": "array", "items": {"type": "object", "required": ["state_id", "severity", "trigger", "inclusion_effect", "metric_availability_effect", "source", "future_override_policy"]}}}},
    "failure_codes": {"type": "array", "items": {"type": "object", "required": ["code", "severity", "stage", "effect"]}},
    "precision_policy": {"type": "object", "required": ["internal_floating_point", "storage_precision", "serialization", "intermediate_rounding", "rounding_before_downstream_calculation", "display_rounding"]},
    "determinism": {"type": "object", "required": ["invariant", "randomness", "llm_calculations", "wall_clock_semantics", "parallel_reduction", "locale_dependence"]},
    "calculation_trace": {"type": "object", "required": ["required_fields", "event_record", "net_force_transform", "metric_dependency_graph", "raw_data_policy"]},
    "result_hash": {"type": "object", "required": ["algorithm", "canonicalization", "included_inputs", "excluded_inputs", "semantic_hash_only"]}
  },
  "additionalProperties": true
}
