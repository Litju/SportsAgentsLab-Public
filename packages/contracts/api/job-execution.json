{
  "api_version": "1",
  "schemas": {
    "CommandSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_type",
        "idempotency_key",
        "request_payload",
        "requested_operation",
        "authority_context_reference",
        "correlation_metadata"
      ],
      "properties": {
        "command_type": { "$ref": "CommandType" },
        "idempotency_key": { "$ref": "IdempotencyKey" },
        "request_payload": { "$ref": "CommandPayload" },
        "requested_operation": { "$ref": "RequestedOperation" },
        "request_reference": { "$ref": "ObjectReference" },
        "authority_context_reference": { "$ref": "ObjectReference" },
        "correlation_metadata": { "$ref": "CorrelationMetadata" }
      }
    },
    "CommandAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "job", "reused"],
      "properties": {
        "command": { "$ref": "Command" },
        "job": { "$ref": "Job" },
        "reused": { "type": "boolean" }
      }
    },
    "ProgressEventCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": { "type": "array", "items": { "$ref": "ProgressEvent" } }
      }
    },
    "CancellationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code"],
      "properties": {
        "reason_code": { "type": "string", "enum": ["USER_REQUESTED"] }
      }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "ApiErrorCode" },
            "message": { "$ref": "ReasonText" }
          }
        }
      }
    },
    "ApiErrorCode": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "INVALID_COMMAND_PAYLOAD",
        "IDEMPOTENCY_CONFLICT",
        "JOB_NOT_FOUND",
        "JOB_NOT_CLAIMABLE",
        "INVALID_JOB_TRANSITION",
        "JOB_ALREADY_TERMINAL",
        "CANCELLATION_NOT_ALLOWED",
        "ATTEMPT_LIMIT_EXCEEDED",
        "WORKER_FAILURE_RETRYABLE",
        "WORKER_FAILURE_NON_RETRYABLE",
        "EXECUTION_OUTCOME_UNKNOWN",
        "JOB_PERSISTENCE_FAILED",
        "UNKNOWN_COMMAND_TYPE",
        "UNKNOWN_WORKER_TYPE",
        "PROGRESS_SEQUENCE_CONFLICT",
        "RECONCILIATION_REQUIRED",
        "INVALID_PROGRESS_EVENT"
      ]
    }
  },
  "operations": {
    "/commands": {
      "post": {
        "operationId": "submitCommand",
        "requestBody": "CommandSubmission",
        "success": { "status": "202", "schema": "CommandAccepted" },
        "errors": [
          { "status": "400", "description": "Invalid command" },
          { "status": "409", "description": "Idempotency conflict" },
          { "status": "500", "description": "Persistence failure" }
        ]
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "getJob",
        "success": { "status": "200", "schema": "Job" },
        "errors": [
          { "status": "404", "description": "Job not found" },
          { "status": "500", "description": "Persistence failure" }
        ]
      }
    },
    "/jobs/{job_id}/progress": {
      "get": {
        "operationId": "getJobProgress",
        "success": { "status": "200", "schema": "ProgressEventCollection" },
        "errors": [
          { "status": "404", "description": "Job not found" },
          { "status": "500", "description": "Persistence failure" }
        ]
      }
    },
    "/jobs/{job_id}/cancellation": {
      "post": {
        "operationId": "requestJobCancellation",
        "requestBody": "CancellationRequest",
        "success": { "status": "202", "schema": "Job" },
        "errors": [
          { "status": "404", "description": "Job not found" },
          { "status": "409", "description": "Cancellation is not allowed" },
          { "status": "500", "description": "Persistence failure" }
        ]
      }
    }
  }
}
